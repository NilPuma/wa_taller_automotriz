    {{!-- ================Area pricipal de trabajo================ --}}

    <section id="contenedorPrincipal">
        <div id="header">
            <div class="contenedor-header row d-flex align-items-center">
                {{!-- <div class="col">
                    <div>
                        <img src="img/logo.png" alt="" width="120px" class="rounded">
                    </div>
                </div> --}}
                <div class="col">
                    {{!-- <span>Perfil administrador</span> --}}
                </div>
                {{!-- <div class="col text-end">
                    <span><a href="/" class="btn-salir"><i class="bi bi-geo-alt-fill"></i>&nbsp Interval</a></span>
                </div> --}}
            </div>
        </div>

        {{!-- Area reactiva administrador --}}
        <div class="row">
            <div class="col">
                <div id="contenedorReactivo" class="flex-colum text-center">
                    {{!-- Aqui se reenderiza todo --}}
                </div>

                {{!-- TEMPLATES --}}
                {{!-- Template: Dashboard --}}
                <template id="templateDashboard">
                    <div class="dashboard">
                        {{!-- BANNER DE BIENVENIDA --}}
                        <section class="dashboard-banner">
                            <div class="dashboard-bienvenida">
                                <span>Bienvenido,</span>
                                <h2 id="dashboardNombreUsuario">Administrador</h2> 
                                <p>
                                    Desde aquí puedes gestionar Clientes, Vehiculos,
                                    Productos, Ordenes, Reportes de manera rápida y segura.
                                </p>
                            </div>

                            <div class="dashboard-logo">
                                <img src="/img/logo.png" alt="" >
                            </div>
                        </section>

                        {{!-- TARJETAS ESTADÍSTICAS --}}
                        <section class="dashboard-estadisticas">

                            <div class="dashboard-stat-card">
                                <div class="stat-icon azul">
                                    <i class="bi bi-people"></i>
                                </div>
                                <div class="stat-contenido">
                                    <h3 id="dashTotalPersonas">--</h3>
                                    <p>Personas registradas</p>
                                    <span>Registros del sistema</span>
                                </div>
                            </div>

                            <div class="dashboard-stat-card">
                                <div class="stat-icon verde">
                                    <i class="bi bi-file-earmark-text"></i>
                                </div>
                                <div class="stat-contenido">
                                    <h3 id="dashTotalCertificados">--</h3>
                                    <p>Vehiculos Registrados</p>
                                    <span>Detalles e historial</span>
                                </div>
                            </div>

                            <div class="dashboard-stat-card">
                                <div class="stat-icon naranja">
                                    <i class="bi bi-chat-left-dots"></i>
                                </div>
                                <div class="stat-contenido">
                                    <h3 id="dashMensajesPendientes">--</h3>
                                    <p>Citas pendientes</p>
                                    <span>Por revisar</span>
                                </div>
                            </div>

                            <div class="dashboard-stat-card">
                                <div class="stat-icon morado">
                                    <i class="bi bi-person"></i>
                                </div>
                                <div class="stat-contenido">
                                    <h3 id="dashTotalUsuarios">--</h3>
                                    <p>Usuarios del sistema</p>
                                    <span>Cuentas registradas</span>
                                </div>
                            </div>

                        </section>

                        {{!-- ACCIONES RÁPIDAS --}}
                        <section class="dashboard-seccion">

                            <h5 class="dashboard-seccion-titulo">
                                <i class="bi bi-lightning-charge"></i>
                                Acciones rápidas
                            </h5>

                            <div class="dashboard-acciones">

                                <button class="dashboard-accion accion-azul"
                                        type="button"
                                        data-modulo="personas">
                                    <div class="accion-icono">
                                        <i class="bi bi-people"></i>
                                    </div>
                                    <div class="accion-texto">
                                        <strong>Gestionar personas</strong>
                                        <small>Ver, registrar y administrar personas.</small>
                                    </div>
                                    <i class="bi bi-chevron-right accion-flecha"></i>
                                </button>

                                <button class="dashboard-accion accion-verde"
                                        type="button"
                                        data-modulo="certificados">
                                    <div class="accion-icono">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </div>
                                    <div class="accion-texto">
                                        <strong>Gestionar Cotizaciones</strong>
                                        <small>Consultar y administrar Cotizaciones.</small>
                                    </div>
                                    <i class="bi bi-chevron-right accion-flecha"></i>
                                </button>

                                <button class="dashboard-accion accion-naranja"
                                        type="button"
                                        data-modulo="mensajes">
                                    <div class="accion-icono">
                                        <i class="bi bi-chat-left-dots"></i>
                                    </div>
                                    <div class="accion-texto">
                                        <strong>Ver citas</strong>
                                        <small>Revisar citas pendientes</small>
                                    </div>
                                    <i class="bi bi-chevron-right accion-flecha"></i>
                                </button>

                                <button class="dashboard-accion accion-morado"
                                        type="button"
                                        data-modulo="usuarios">
                                    <div class="accion-icono">
                                        <i class="bi bi-person-gear"></i>
                                    </div>
                                    <div class="accion-texto">
                                        <strong>Gestionar usuarios</strong>
                                        <small>Administrar cuentas de acceso y roles.</small>
                                    </div>
                                    <i class="bi bi-chevron-right accion-flecha"></i>
                                </button>

                            </div>
                        </section>

                        {{!-- TABLAS DE ACTIVIDAD RECIENTE --}}
                        <section class="dashboard-actividad">

                            {{!-- MENSAJES --}}
                            <div class="dashboard-seccion">

                                <div class="dashboard-tabla-header">
                                    <h5 class="dashboard-seccion-titulo">
                                        <i class="bi bi-clock-history"></i>
                                        Últimos Orndes de trabajo antedidas recibidos
                                    </h5>

                                    <button class="dashboard-ver-todos"
                                            type="button"
                                            data-modulo="mensajes">
                                        Ver todos
                                    </button>
                                </div>

                                <div class="table-responsive">
                                    <table class="table dashboard-tabla">
                                        <thead>
                                            <tr>
                                                <th>Nombre</th>
                                                <th>Correo</th>
                                                <th>Ciudad</th>
                                                <th>Mensaje</th>
                                                <th>Fecha</th>
                                            </tr>
                                        </thead>
                                        <tbody id="dashTablaMensajes">
                                            <tr>
                                                <td colspan="5" class="text-center">
                                                    Cargando mensajes...
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                            {{!-- CERTIFICADOS --}}
                            <div class="dashboard-seccion">

                                <div class="dashboard-tabla-header">
                                    <h5 class="dashboard-seccion-titulo">
                                        <i class="bi bi-file-earmark-check"></i>
                                        Últimas Citas registradas
                                    </h5>

                                    <button class="dashboard-ver-todos"
                                            type="button"
                                            data-modulo="certificados">
                                        Ver todos
                                    </button>
                                </div>

                                <div class="table-responsive">
                                    <table class="table dashboard-tabla">
                                        <thead>
                                            <tr>
                                                <th>Código</th>
                                                <th>Persona</th>
                                                <th>Título</th>
                                                <th>Fecha</th>
                                            </tr>
                                        </thead>
                                        <tbody id="dashTablaCertificados">
                                            <tr>
                                                <td colspan="4" class="text-center">
                                                    Cargando certificados...
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </section>

                    </div>

                </template>

                {{!-- Template clientes --}}
                <template id="templateContenedorClientes">
                    <div id="clientesAdmin" class="p-4 container">
                        {{!-- Card de Clientes --}}
                        <div class="card-tabla">
                            <div class="card-body p-0">
                                {{!-- Título y buscador dentro de la card --}}
                                <div class="seccion-titulo">
                                    <div class="d-flex justify-content-start align-items-center flex-wrap gap-3">
                                        <h5 class="fw-bold mb-0"><i
                                                class="bi bi-file-earmark-text me-2 text-primary"></i>PERSONAS/EMPRESAS
                                        </h5>
                                    </div>
                                    <div class="seccion-busqueda">
                                        <div class="input-group input-group-sm" style="max-width: 320px;">
                                            <span class="input-group-text bg-white">
                                                <i class="bi bi-search"></i>
                                            </span>
                                            <input type="text" class="form-control form-control-sm"
                                                id="inputBuscarCertificado" placeholder="Buscar por código o nombre...">
                                        </div>
                                        <div>
                                            <span type="button" class="btn btn-primario btn-guardar-registro" data-bs-toggle="modal" data-bs-target="#modalRegistro">
                                                AñadirPersona/Empresa
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-hover style-tabla">
                                        <thead>
                                            <tr>
                                                <th class="ps-3">ID</th>
                                                <th class="">DOCUMENTO</th>
                                                <th class="">NOMBRES</th>
                                                <th class="">TELEFONO</th>
                                                {{!-- <th class="">ESTADO</th> --}}
                                                <th class="">OPCIONES</th>
                                            </tr>
                                        </thead>
                                        <tbody id="contenedorTablaCliente" class="text-center">
                                            {{!-- Aqui se reendiriza los datos dinamicamente --}}
                                        </tbody>

                                        <template id="templateTablaClientes">
                                            <tr>
                                                <td class="id-persona"></td>
                                                <td class="documento-persona"></td>
                                                <td class="nombres-persona"></td>
                                                <td class="telefono-persona"></td>
                                                {{!-- <td id="contenedorEstadoListar" class="text-center"></td> --}}
                                                <td>
                                                    <div class="d-flex justify-content-center">
                                                        <span id="verVehiculo" class="bi bi-car-front-fill text-primary"
                                                            title="Ver certificados del cliente"></span>
                                                        <span id="editarPersona"
                                                            class="bi bi-pen-fill me-3 ms-3 text-secondary"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#modalEditarPersona"></span>
                                                        <span id="eliminarPersona"
                                                            class="bi bi-trash3-fill text-danger"></span>
                                                    </div>
                                                </td>
                                            </tr>
                                        </template>
                                    </table>
                                </div>

                                {{!-- Info, Selector de registros y Paginación --}}
                                <div class="p-3 border-top">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                        <div class="d-flex align-items-center gap-3 flex-wrap">
                                            <div class="small text-muted" id="infoPaginacion">
                                                {{!-- Se llena dinámicamente --}}
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <label class="small text-muted mb-0">Mostrar:</label>
                                                <select id="selectRegistrosPorPagina"
                                                    class="form-select form-select-sm">
                                                    <option value="3">3</option>
                                                    <option value="5" selected>5</option>
                                                    <option value="10">10</option>
                                                    <option value="20">20</option>
                                                </select>
                                            </div>
                                        </div>

                                        <nav aria-label="Paginación de clientes">
                                            <ul class="pagination pagination-sm mb-0" id="paginacionClientes">
                                                {{!-- Se llena dinámicamente con JavaScript --}}
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
                <template id="templateVehiculos">
                    <div class="">
                        <span class="Vehiculos"></span>
                    </div>
                </template>
            </div>
        </div>
    </section>
    {{!-- ==================== Modal Registrar Persona/Empresa ==================== --}}
    <div class="modal fade modal-personalizado" id="modalRegistro" data-bs-backdrop="static"
        data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalRegistroLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title" id="modalRegistroLabel">Registrar nuevo Cliente</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div id="registroBody" class="modal-body">
                    <div class="row">
                        <div class="col-lg-6 mb-3">
                            <select id="tipoDocumento" name="tipo_documento" class="form-select select-style ">
                                <option value="DNI" class="option-styles">DNI</option>
                                <option value="RUC">RUC</option>
                                <option value="CE">Carné de extranjería</option>
                                <option value="PASAPORTE">Pasaporte</option>
                            </select>
                        </div>

                        <div class="col-lg-6">
                            <div class="input-style mb-3">
                                <input id="documento" class="input-style-error" type="number" placeholder=" ">
                                <label for="documento">
                                    <i class="bi bi-window-dock me-2"></i>N° Documento
                                </label>
                            </div>
                        </div>
                    </div>
                    <div id="contenedorDatosCliente" class="row g-3">
                        {{!-- Aqui se reenderiza campos por tipo de cliente --}}
                    </div>
                    <div class="input-style mb-3">
                        <input id="direccion" class="input-style-error" type="text" placeholder=" ">
                        <label for="direccion">
                            <i class="bi bi-telephone me-2"></i>Dirección
                        </label>
                    </div>
                    <div class="input-style mb-3">
                        <input id="telefono" class="input-style-error" type="number" placeholder=" ">
                        <label for="telefono">
                            <i class="bi bi-telephone me-2"></i>Teléfono
                        </label>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <span type="button" class="btn btn-cancelar me-2" data-bs-dismiss="modal">Cancelar</span>
                    <span id="btnAñadirCliente" type="button" class="btn btn-primario btn-guardar-registro"><i
                            class="bi bi-check2 me-2"></i>Registrar</span>
                </div>

            </div>
        </div>
    </div>


    <!-- Toast de notificaciones -->
    <div id="toastContainer" class="toast-container-custom" aria-live="polite" aria-atomic="true">
        <div id="toastCertificado" class="toast-personalizado" role="alert">
            <i id="toastIcono" class="bi toast-icono"></i>
            <div class="toast-contenido">
                <p id="toastTitulo" class="toast-titulo mb-0"></p>
                <p id="toastMensaje" class="toast-mensaje mb-0"></p>
            </div>
            <button type="button" id="toastCerrar" class="toast-cerrar" aria-label="Cerrar notificación">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/js/administrador.js"></script>