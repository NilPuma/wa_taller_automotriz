    {{!-- Modal para previsualizar y descargar un ticket de OT. --}}
    <div class="modal fade modal-personalizado" id="modalTicketPDF" tabindex="-1" aria-labelledby="modalTicketPDFLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-ticket-pdf__contenido">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTicketPDFLabel">
                        <i class="bi bi-file-earmark-pdf me-2"></i>Ticket de servicio
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div id="contenedorFormatoTicket" class="d-none px-3 pt-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <small class="text-muted">Formato de página</small>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Seleccionar formato del ticket">
                            <button type="button" class="btn filtro-formato-ticket active" data-formato="80mm" aria-pressed="true">80 mm</button>
                            <button type="button" class="btn filtro-formato-ticket" data-formato="a4" aria-pressed="false">A4</button>
                            <button type="button" class="btn filtro-formato-ticket" data-formato="a5" aria-pressed="false">A5</button>
                        </div>
                    </div>
                </div>
                <div id="contenedorFiltrosTicketFinalizacion" class="d-none px-3 pt-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <small class="text-muted">Contenido del ticket</small>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Filtrar ticket de orden finalizada">
                            <button type="button" class="btn filtro-ticket-finalizacion active" data-tipo="general">General</button>
                            <button type="button" class="btn filtro-ticket-finalizacion" data-tipo="servicios">Servicios</button>
                            <button type="button" class="btn filtro-ticket-finalizacion" data-tipo="productos">Productos</button>
                        </div>
                    </div>
                </div>
                <div class="modal-body modal-ticket-pdf__body">
                    <iframe id="iframeTicketPDF" src="about:blank" title="Vista previa del ticket PDF"></iframe>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-primario" id="btnDescargarTicketPDF" disabled>
                        <i class="bi bi-download me-1"></i> Descargar PDF
                    </button>
                    <button type="button" class="btn-cancelar" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
