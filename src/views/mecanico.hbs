                                            <small>Busque una placa para ver los datos del cliente</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {{!-- Sección Inferior: Servicios y Productos --}}
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white border-bottom py-2">
                                <h6 class="mb-0 fw-bold"><i class="bi bi-cart"></i> Servicios y Productos</h6>
                            </div>
                            <div class="card-body p-3">
                                
                                {{!-- ===== SECCIÓN SERVICIOS ===== --}}
                                <div class="mb-3">
                                    <h6 class="fw-bold small text-primary mb-2">
                                        <i class="bi bi-tools"></i> SERVICIOS
                                    </h6>
                                    <div class="row g-2 align-items-end">
                                        <div class="col-5">
                                            <label for="selectServicioCotizacion" class="form-label fw-semibold small">Servicio</label>
                                            <select class="form-control form-control-sm" id="selectServicioCotizacion">
                                                <option value="" selected disabled>Seleccione un servicio</option>
                                            </select>
                                        </div>
                                        <div class="col-2">
                                            <label for="inputCantidadServicio" class="form-label fw-semibold small">Cant.</label>
                                            <input type="number" class="form-control form-control-sm" 
                                                   id="inputCantidadServicio" value="1" min="1">
                                        </div>
                                        <div class="col-3">
                                            <label class="form-label fw-semibold small">P. Unit.</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light">S/</span>
                                                <input type="text" class="form-control form-control-sm text-end" 
                                                       id="inputPrecioServicio" value="0.00" readonly>
                                            </div>
                                        </div>
                                        <div class="col-2">
                                            <button type="button" class="btn btn-primary btn-sm w-100" id="btnAgregarServicio" title="Agregar servicio">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-2">

                                {{!-- ===== SECCIÓN PRODUCTOS ===== --}}
                                <div class="mb-3">
                                    <h6 class="fw-bold small text-success mb-2">
                                        <i class="bi bi-box-seam"></i> PRODUCTOS
                                    </h6>
                                    <div class="row g-2 align-items-end">
                                        <div class="col-5">
                                            <label for="selectProductoCotizacion" class="form-label fw-semibold small">Producto</label>
                                            <select class="form-control form-control-sm" id="selectProductoCotizacion">
                                                <option value="" selected disabled>Seleccione un producto</option>
                                            </select>
                                        </div>
                                        <div class="col-2">
                                            <label for="inputCantidadProducto" class="form-label fw-semibold small">Cant.</label>
                                            <input type="number" class="form-control form-control-sm" 
                                                   id="inputCantidadProducto" value="1" min="1">
                                        </div>
                                        <div class="col-3">
                                            <label class="form-label fw-semibold small">P. Unit.</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light">S/</span>
                                                <input type="text" class="form-control form-control-sm text-end" 
                                                       id="inputPrecioProducto" value="0.00" readonly>
                                            </div>
                                        </div>
                                        <div class="col-2">
                                            <button type="button" class="btn btn-success btn-sm w-100" id="btnAgregarProducto" title="Agregar producto">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-2">

                                {{!-- Tabla de items agregados --}}
                                <div class="tabla-items-container overflow-auto max-h-250">
                                    <table class="table table-sm table-hover align-middle mb-0" id="tablaItemsCotizacion">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th class="small w-60">Tipo</th>
                                                <th class="small">Descripción</th>
                                                <th class="small text-center w-50">Cant.</th>
                                                <th class="small text-end w-80">P. Unit.</th>
                                                <th class="small text-end w-80">Subtotal</th>
                                                <th class="small text-center w-40"></th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyItemsCotizacion">
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-3">
                                                    <i class="bi bi-inbox"></i> No hay items agregados
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <td colspan="4" class="text-end fw-bold small">SUBTOTAL:</td>
                                                <td class="text-end fw-bold small" id="subtotalCotizacion">S/ 0.00</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                            </div>
                        </div>
                    </div>

                    {{!-- ==================== COLUMNA DERECHA: Detalles + Total + Generar ==================== --}}
                    <div class="col-lg-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="bi bi-clipboard-check"></i> Resumen</h5>
                            </div>
                            <div class="card-body p-3 d-flex flex-column">
                                
                                {{!-- Observaciones / Detalles --}}
                                <div class="mb-3">
                                    <label for="textareaObservacionesCotizacion" class="form-label fw-semibold small">
                                        <i class="bi bi-pencil-square"></i> Observaciones / Detalles
                                    </label>
                                    <textarea class="form-control form-control-sm" 
                                              id="textareaObservacionesCotizacion" 
                                              rows="5" 
                                              placeholder="Ingrese observaciones, condiciones, notas adicionales..."></textarea>
                                </div>

                                <hr>

                                {{!-- Resumen de totales --}}
                                <div class="resumen-totales mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small text-muted">Subtotal:</span>
                                        <span class="small fw-semibold" id="resumenSubtotal">S/ 0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small text-muted">IGV (18%):</span>
                                        <span class="small fw-semibold" id="resumenIGV">S/ 0.00</span>
                                    </div>
                                </div>

                                {{!-- Total Final --}}
                                <div class="total-final p-3 rounded mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold">TOTAL</span>
                                        <span class="fw-bold fs-5 text-success" id="totalFinalCotizacion">S/ 0.00</span>
                                    </div>
                                </div>

                                {{!-- Fecha de cotización --}}
                                <div class="mb-3">
                                    <label for="inputFechaCotizacion" class="form-label fw-semibold small">
                                        <i class="bi bi-calendar3"></i> Fecha
                                    </label>
                                    <input type="date" class="form-control form-control-sm" id="inputFechaCotizacion">
                                </div>

                                {{!-- Validez de la cotización --}}
                                <div class="mb-3">
                                    <label for="selectValidezCotizacion" class="form-label fw-semibold small">
                                        <i class="bi bi-clock-history"></i> Validez
                                    </label>
                                    <select class="form-control form-control-sm" id="selectValidezCotizacion">
                                        <option value="7" selected>7 días</option>
                                        <option value="15">15 días</option>
                                        <option value="30">30 días</option>
                                        <option value="60">60 días</option>
                                    </select>
                                </div>

                                <div class="mt-auto">
                                    {{!-- Botón Generar Cotización --}}
                                    <button type="button" class="btn btn-success w-100 mb-2" id="btnGenerarCotizacion">
                                        <i class="bi bi-file-earmark-pdf"></i> GENERAR COTIZACIÓN
                                    </button>
                                    
                                    {{!-- Botón Limpiar --}}
                                    <button type="button" class="btn btn-outline-secondary w-100" id="btnLimpiarCotizacion">
                                        <i class="bi bi-eraser"></i> Limpiar Todo
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </template>

        {{!-- Template para la vista de Cotizaciones 2 --}}
        <template id="templateCotizaciones2">
            <div id="cotizaciones2" class="p-4 container">

                {{!-- Header --}}
                <div class="cotizaciones2-header d-flex align-items-center justify-content-between mb-4">
                    <div class="w-40"></div>
                    <h1 class="text-center fw-bold mb-0 flex-grow-1">COTIZACIONES</h1>
                </div>

                {{!-- Buscador + Botón Nueva Cotización --}}
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                    <div class="input-group input-group-sm max-w-320">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control form-control-sm" id="inputBuscarCotizacion2" placeholder="Buscar por código, placa o cliente...">
                    </div>
                    <button type="button" class="btn btn-success btn-sm" id="btnNuevaCotizacion2"
                            data-bs-toggle="modal" data-bs-target="#modalNuevaCotizacion2">
                        <i class="bi bi-plus-circle"></i> NUEVA COTIZACIÓN
                    </button>
                </div>

                {{!-- Tabla general de Cotizaciones --}}
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">CÓDIGO</th>
                                        <th>PLACA</th>
                                        <th>CLIENTE</th>
                                        <th>MECÁNICO</th>
                                        <th>FECHA</th>
                                        <th class="text-center">ITEMS</th>
                                        <th class="text-end">TOTAL</th>
                                        <th class="text-center">ESTADO</th>
                                    </tr>
                                </thead>
                                <tbody id="tabla-cotizaciones2-body">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </template>

    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/js/mecanico.js"></script>