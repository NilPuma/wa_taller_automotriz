{{!-- ============================================================
     TEMPLATE: mecanico.hbs (Layout principal del mecánico)
     Incluye el dashboard como contenido inicial
     ============================================================ --}}

<div id="bodyAdministrador">
    
    <div id="sideMenu" class="menu-colapsado">
        {{!-- Header --}}
        <div id="cabecera">
            <div id="titulo"><span>MI TALLER</span></div>
            <div id="menuBtn">
                <div class="btn-hamburger"></div>
                <div class="btn-hamburger"></div>
                <div class="btn-hamburger"></div>
            </div>
        </div>
        {{!-- Perfil --}}
        <div id="perfil">
            <div id="foto"><img src="/img/perfil.png" alt="" ></div>
            <div id="nombre"><span>MECANICO</span></div>
        </div>
        {{!-- Items --}}
        <div id="menuItems">
            <div class="item">
                <a href="#" id="btnMenuInicio">
                    <div class="icono"><img src="/icons/home.svg" alt="" ></div>
                    <div class="titulo"><span>Inicio</span></div>
                </a>
            </div>
            <div class="item-separator"></div>
            <div class="item">
                <a href="#" id="btnMenuOrdenes">
                    <div class="icono"><img src="/icons/ordenes.svg" alt="" ></div>
                    <div class="titulo"><span>Ordenes</span></div>
                </a>
            </div>
            <div class="item-separator"></div>
            <div class="item">
                <a href="#" id="btnMenuAgenda">
                    <div class="icono"><img src="/icons/agenda.svg" alt="" ></div>
                    <div class="titulo"><span>Agenda</span></div>
                </a>
            </div>
            <div class="item-separator"></div>
            <div class="item">
                <a href="#" id="btnMenuHistorial">
                    <div class="icono"><img src="/icons/historial.svg" alt="" ></div>
                    <div class="titulo"><span>Historial</span></div>
                </a>
            </div>
            <div class="item-separator"></div>
            <div class="item">
                <a href="#" id="btnMenuCotizaciones">
                    <div class="icono"><img src="/icons/dolar.svg" alt="" ></div>
                    <div class="titulo"><span>Cotizaciones</span></div>
                </a>
            </div>
            <div class="item-separator"></div>
            <div class="item">
                <a href="#" id="btnMenuCotizaciones2">
                    <div class="icono"><img src="/icons/dolar.svg" alt="" ></div>
                    <div class="titulo"><span>Cotizaciones 2</span></div>
                </a>
            </div>
            <div class="item-separator"></div>
            <div class="item">
                <a href="#" id="btnMenuCitas">
                    <div class="icono"><img src="/icons/citas.svg" alt="" ></div>
                    <div class="titulo"><span>Citas</span></div>
                </a>
            </div>
            <div class="item-separator"></div>
            <div class="item">
                <a href="#" id="btnMenuCerrarSesion">
                    <div class="icono"><img src="/icons/turn-off.svg" alt="" ></div>
                    <div class="titulo"><span>Cerrar Sesion</span></div>
                </a>
            </div>
        </div>
    </div>

    {{!-- ================Area principal de trabajo================ --}}

    <section id="contenedorPrincipal">
        <div id="header">
            <div class="contenedor-header d-flex align-items-center justify-content-between px-3">
                <div>
                    <span>Perfil Mecánico</span>
                </div>
                <div>
                    <span><a href="/" class="btn-salir"><i class="bi bi-geo-alt-fill"></i>&nbsp; Interval</a></span>
                </div>
            </div>
        </div>

        {{!-- Area reactiva mecanico  --}}
        <div id="contenedorReactivo">
            
            {{!-- ================= DASHBOARD CON BOOTSTRAP ================= --}}
            <div id="dashboard" class="p-4 container">

                <h1 class="text-center fw-bold mb-4 ">DASHBOARD</h1>

                {{!-- KPI Cards con Bootstrap --}}
                <div class="row g-3 mb-4">
                    
                    {{!-- Card: Órdenes Asignadas --}}
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body d-flex justify-content-between align-items-center p-3">
                                <div>
                                    <span class="fw-semibold text-secondary d-block mb-2">Órdenes Asignadas</span>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <strong class="fs-3 text-dark valor-ordenes-asignadas">--</strong>
                                        <small class="text-muted">Pendientes</small>
                                    </div>
                                </div>
                                <div id="grafico-ordenes" class="card-kpi-grafico">
                                    <svg viewBox="0 0 36 36" class="w-100 h-100">
                                        <path class="circulo-fondo"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                        <path class="circulo-progreso"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" 
                                            stroke-dasharray="0, 100" transform="rotate(-90 18 18)"/>
                                        <text x="18" y="20.5" class="porcentaje-texto">--</text>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>

                    {{!-- Card: Trabajos en Proceso --}}
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body d-flex justify-content-between align-items-center p-3">
                                <div>
                                    <span class="fw-semibold text-secondary d-block mb-2">Trabajos en Proceso</span>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <strong class="fs-3 text-dark valor-trabajos-proceso">--</strong>
                                        <small class="text-muted">En ejecución</small>
                                    </div>
                                </div>
                                <div id="grafico-proceso" class="card-kpi-grafico">
                                    <svg viewBox="0 0 36 36" class="w-100 h-100">
                                        <path class="circulo-fondo"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                        <path class="circulo-progreso"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" 
                                            stroke-dasharray="0, 100" transform="rotate(-90 18 18)"/>
                                        <text x="18" y="20.5" class="porcentaje-texto">--</text>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>

                    {{!-- Card: Órdenes Finalizadas Hoy --}}
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body d-flex justify-content-between align-items-center p-3">
                                <div>
                                    <span class="fw-semibold text-secondary d-block mb-2">Órdenes Finalizadas Hoy</span>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <strong class="fs-3 text-dark valor-ordenes-finalizadas">--</strong>
                                        <small class="text-muted">Completadas</small>
                                    </div>
                                </div>
                                <div id="grafico-finalizadas" class="card-kpi-grafico">
                                    <svg viewBox="0 0 36 36" class="w-100 h-100">
                                        <path class="circulo-fondo"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                        <path class="circulo-progreso"
                                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" 
                                            stroke-dasharray="0, 100" transform="rotate(-90 18 18)"/>
                                        <text x="18" y="20.5" class="porcentaje-texto">--</text>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>

                    {{!-- Card: Tiempo Promedio --}}
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body d-flex justify-content-between align-items-center p-3">
                                <div>
                                    <span class="fw-semibold text-secondary d-block mb-2">Tiempo Promedio</span>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <strong class="fs-3 text-dark valor-tiempo-promedio">--</strong>
                                        <small class="text-muted">Por orden</small>
                                    </div>
                                </div>
                                <div id="grafico-barras" class="grafico-barras-mini">
                                    <div class="barra"></div>
                                    <div class="barra"></div>
                                    <div class="barra"></div>
                                    <div class="barra"></div>
                                    <div class="barra activa" data-valor="--"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {{!-- Tabla de Órdenes Pendientes con Bootstrap --}}
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom">
                        <h5 class="mb-0 fw-bold">Órdenes Pendientes</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">N° DE ORDEN</th>
                                        <th>CLIENTE</th>
                                        <th>TIPO DE SERVICIO</th>
                                        <th>MECÁNICO</th>
                                        <th>ESTADO</th>
                                    </tr>
                                </thead>
                                <tbody id="tabla-ordenes-body">
                                    <!-- Se llena dinámicamente con JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
            {{!-- ================= FIN DASHBOARD ================= --}}

        </div>

        {{!-- ================= MODAL NUEVA ORDEN ================= --}}
        <div class="modal fade" id="modalNuevaOrden" tabindex="-1" aria-labelledby="modalNuevaOrdenLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    {{!-- Header --}}
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="modalNuevaOrdenLabel">NUEVA ORDEN</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    {{!-- Body --}}
                    <div class="modal-body">
                        <form id="formNuevaOrden">
                            <div class="row g-3">
                                {{!-- Nro Orden (automático) --}}
                                <div class="col-md-3">
                                    <label for="inputNroOrden" class="form-label fw-semibold">Nro Orden</label>
                                    <input type="text" class="form-control" id="inputNroOrden" readonly disabled>
                                </div>
                                {{!-- Placa / Matrícula --}}
                                <div class="col-md-3">
                                    <label for="inputPlaca" class="form-label fw-semibold">Placa</label>
                                    <input type="text" class="form-control text-uppercase" id="inputPlaca" 
                                           name="placa" placeholder="ABC-123" required>
                                </div>
                                {{!-- Cliente --}}
                                <div class="col-md-3">
                                    <label for="inputCliente" class="form-label fw-semibold">Cliente</label>
                                    <input type="text" class="form-control" id="inputCliente" 
                                           name="cliente" placeholder="Nombre del cliente" required>
                                </div>
                                {{!-- Documento --}}
                                <div class="col-md-3">
                                    <label for="inputDocumento" class="form-label fw-semibold">Documento</label>
                                    <input type="text" class="form-control" id="inputDocumento" 
                                           name="documento" placeholder="DNI / RUC">
                                </div>
                                {{!-- Tipo de Servicio (dropdown) --}}
                                <div class="col-md-6">
                                    <label for="selectTipoServicio" class="form-label fw-semibold">Tipo de Servicio</label>
                                    <select class="form-control" id="selectTipoServicio" name="tipoServicio" required>
                                        <option value="" selected disabled>Seleccione un servicio</option>
                                    </select>
                                </div>
                                {{!-- Mecánico (dropdown) --}}
                                <div class="col-md-6">
                                    <label for="selectMecanico" class="form-label fw-semibold">Mecánico</label>
                                    <select class="form-control" id="selectMecanico" name="mecanico" required>
                                        <option value="" selected disabled>Seleccione un mecánico</option>
                                    </select>
                                </div>
                                {{!-- Descripción --}}
                                <div class="col-12">
                                    <label for="textareaDescripcion" class="form-label fw-semibold">Descripción</label>
                                    <textarea class="form-control" id="textareaDescripcion" name="descripcion" 
                                              rows="3" placeholder="Descripción de la falla o del trabajo a realizar"></textarea>
                                </div>
                            </div>
                        </form>
                    </div>
                    {{!-- Footer --}}
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" form="formNuevaOrden" class="btn btn-success" id="btnGuardarOrden">
                            <i class="bi bi-check-circle"></i> Guardar Orden
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {{!-- ================= FIN MODAL NUEVA ORDEN ================= --}}

        {{!-- ================= MODAL HORARIO AGENDA ================= --}}
        <div class="modal fade" id="modalHorario" tabindex="-1" aria-labelledby="modalHorarioLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    {{!-- Header --}}
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="modalHorarioLabel">HORARIO</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    {{!-- Tabs: mecánico / día --}}
                    <div class="modal-tabs px-3 pt-2">
                        <span class="tab-mecanico fw-bold" id="nombreMecanicoModal">MECANICO</span>
                        <span class="tab-separador">|</span>
                        <div class="tab-dias d-inline-flex gap-1" id="tabsDiasHorario">
                            <a href="#" class="tab-dia active" data-dia="LUNES">LUNES</a>
                            <a href="#" class="tab-dia" data-dia="MARTES">MARTES</a>
                            <a href="#" class="tab-dia" data-dia="MIERCOLES">MIERCOLES</a>
                            <a href="#" class="tab-dia" data-dia="JUEVES">JUEVES</a>
                            <a href="#" class="tab-dia" data-dia="VIERNES">VIERNES</a>
                            <a href="#" class="tab-dia" data-dia="SABADO">SABADO</a>
                        </div>
                    </div>
                    {{!-- Body --}}
                    <div class="modal-body">
                        <input type="hidden" id="diaSeleccionadoHorario" value="LUNES">
                        {{!-- Selector de rango horario --}}
                        <div class="fila-agregar-horario d-flex align-items-center gap-2 mb-3">
                            <select class="form-control form-control-sm" id="selectHoraInicio">
                                <option value="" selected disabled>--:--</option>
                            </select>
                            <span class="fw-semibold">A</span>
                            <select class="form-control form-control-sm" id="selectHoraFin">
                                <option value="" selected disabled>--:--</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-agregar-horario" id="btnAgregarHorario">AGREGAR</button>
                        </div>
                        <hr>
                        {{!-- Lista de bloques ocupados --}}
                        <div id="listaBloquesOcupados">
                            <p class="text-muted mb-0">No hay horarios ocupados este día.</p>
                        </div>
                        {{!-- Template para nuevos bloques --}}
                        <template id="templateBloqueOcupado">
                            <div class="bloque-ocupado d-flex align-items-center gap-2 mb-2">
                                <span class="badge-ocupado-modal">OCUPADO</span>
                                <span class="bloque-horario"></span>
                                <a href="#" class="btn-eliminar-bloque ms-auto" title="Quitar horario">&#128465;</a>
                            </div>
                        </template>
                    </div>
                    {{!-- Footer --}}
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">CANCELAR</button>
                        <button type="button" class="btn btn-guardar-horario" id="btnGuardarHorario">GUARDAR</button>
                    </div>
                </div>
            </div>
        </div>
        {{!-- ================= FIN MODAL HORARIO AGENDA ================= --}}

        {{!-- ================= MODAL NUEVA COTIZACION 2 (ESTILO PRESUPUESTO PRO) ================= --}}
        <div class="modal fade" id="modalNuevaCotizacion2" tabindex="-1" aria-labelledby="modalNuevaCotizacion2Label" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-xl modal-scrollable">
                <div class="modal-content">
                    {{!-- Header --}}
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalNuevaCotizacion2Label">
                            <i class="fas fa-file-invoice"></i> NUEVA COTIZACIÓN
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    {{!-- Body --}}
                    <div class="modal-body">

                        {{!-- TARJETA 1: Placa y Mecánico --}}
                        <div class="card-presupuesto">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="label-presupuesto">
                                        <i class="fas fa-car"></i> Placa del Vehículo
                                    </label>
                                    <div class="input-group">
                                        <input type="text" class="form-control text-uppercase" id="inputPlacaCot2" placeholder="ABC-123">
                                        <button class="btn btn-primary btn-sm ms-2" type="button" id="btnBuscarPlacaCot2" title="Buscar vehículo" style="border-radius: 10px;">
                                            <i class="fas fa-search"></i> Buscar
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="label-presupuesto" for="selectMecanicoCot2">
                                        <i class="fas fa-user-cog"></i> Mecánico
                                    </label>
                                    <select class="form-control" id="selectMecanicoCot2">
                                        <option value="" selected disabled>Seleccione un mecánico</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        {{!-- TARJETA 2: Datos Cliente y Vehículo --}}
                        <div class="card-presupuesto">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div style="border-right: 1px dashed #ccc; padding-right: 15px;">
                                        <div class="section-header-presupuesto" style="background: #2980b9;">
                                            <span><i class="fas fa-user"></i> DATOS DEL CLIENTE</span>
                                        </div>
                                        <div id="infoClienteCot2" class="d-none">
                                            <p style="margin:3px 0;"><strong id="cot2ClienteNombre">--</strong></p>
                                            <p style="margin:3px 0; font-size:0.85em;">Telefono: <span id="cot2ClienteTelefono">--</span></p>
                                            <p style="margin:3px 0; font-size:0.85em;">Email: <span id="cot2ClienteEmail">--</span></p>
                                            <p style="margin:3px 0; font-size:0.85em;">Documento: <span id="cot2ClienteDocumento">--</span></p>
                                        </div>
                                        <div id="mensajeSinClienteCot2" style="color:#95a5a6; font-size:0.85em;">
                                            Busque una placa para ver los datos del cliente.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div style="padding-left: 15px;">
                                        <div class="section-header-presupuesto" style="background: #2980b9;">
                                            <span><i class="fas fa-car-side"></i> DATOS DEL VEHÍCULO</span>
                                        </div>
                                        <div id="infoVehiculoCot2" class="d-none">
                                            <p style="margin:3px 0;"><strong id="cot2VehiculoNombre">--</strong></p>
                                            <p style="margin:3px 0; font-size:0.85em;">Placa: <span id="cot2VehiculoPlaca">--</span></p>
                                            <p style="margin:3px 0; font-size:0.85em;">Color: <span id="cot2VehiculoColor">--</span></p>
                                            <p style="margin:3px 0; font-size:0.85em;">Kilometraje: <span id="cot2VehiculoKm">--</span></p>
                                        </div>
                                        <div id="mensajeSinVehiculoCot2" style="color:#95a5a6; font-size:0.85em;">
                                            Busque una placa para ver los datos del vehículo.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {{!-- TARJETA 3: Servicios --}}
                        <div class="card-presupuesto">
                            <div class="section-header-presupuesto">
                                <span><i class="fas fa-clipboard-list"></i> 1. SERVICIOS</span>
                                <span id="totServiciosCot2" style="background:#fff; color:#2c3e50; padding:2px 10px; border-radius:4px; font-size:0.9em;">S/ 0.00</span>
                            </div>
                            {{!-- Fila para agregar --}}
                            <div class="row g-2 align-items-end mb-3 p-2" style="background:#f8f9fa; border-radius:8px;">
                                <div class="col-5">
                                    <select class="form-control" id="selectServicioCot2">
                                        <option value="" selected disabled>Seleccione un servicio</option>
                                    </select>
                                </div>
                                <div class="col-2">
                                    <input type="number" class="form-control text-center" id="inputCantidadServicioCot2" value="1" min="1">
                                </div>
                                <div class="col-3">
                                    <input type="text" class="form-control text-end" id="inputPrecioServicioCot2" value="0.00" readonly>
                                </div>
                                <div class="col-2">
                                    <button type="button" class="btn-agregar-presupuesto" id="btnAgregarServicioCot2">
                                        <i class="fas fa-plus"></i> Agregar
                                    </button>
                                </div>
                            </div>
                            {{!-- Lista de servicios agregados --}}
                            <div id="listServiciosCot2"></div>
                        </div>

                        {{!-- TARJETA 4: Refacciones --}}
                        <div class="card-presupuesto">
                            <div class="section-header-presupuesto" style="background: #e67e22;">
                                <span><i class="fas fa-box-open"></i> 2. REFACCIONES Y MATERIALES</span>
                                <span id="totRefaccionesCot2" style="background:#fff; color:#e67e22; padding:2px 10px; border-radius:4px; font-size:0.9em;">S/ 0.00</span>
                            </div>
                            {{!-- Fila para agregar --}}
                            <div class="row g-2 align-items-end mb-3 p-2" style="background:#f8f9fa; border-radius:8px;">
                                <div class="col-5">
                                    <select class="form-control" id="selectProductoCot2">
                                        <option value="" selected disabled>Seleccione un producto</option>
                                    </select>
                                </div>
                                <div class="col-2">
                                    <input type="number" class="form-control text-center" id="inputCantidadProductoCot2" value="1" min="1">
                                </div>
                                <div class="col-3">
                                    <input type="text" class="form-control text-end" id="inputPrecioProductoCot2" value="0.00" readonly>
                                </div>
                                <div class="col-2">
                                    <button type="button" class="btn-agregar-presupuesto" id="btnAgregarProductoCot2" style="background:#f39c12;">
                                        <i class="fas fa-plus"></i> Agregar
                                    </button>
                                </div>
                            </div>
                            {{!-- Encabezados --}}
                            <div style="font-size:0.75em; color:#7f8c8d; margin-bottom:5px; display:grid; grid-template-columns: 2fr 0.5fr 0.8fr 0.8fr 30px; gap:10px; font-weight:bold;">
